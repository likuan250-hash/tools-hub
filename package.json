{
  "name": "tools-hub",
  "version": "0.1.10",
  "description": "工具统一桌面应用：集成 kdocs-tool 与 netdisk-hub，单启动器、单安装包",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "node scripts/prepare-build.js && electron-builder --dir",
    "dist": "node scripts/prepare-build.js && electron-builder --win nsis -p always"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.likuan.tools-hub",
    "productName": "工具箱 ToolsHub",
    "copyright": "Copyright © 2026 likuan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "kdocs-tool",
        "to": "kdocs-tool",
        "filter": ["**/*", "!node_modules/**/.cache", "!**/*.log"]
      },
      {
        "from": "netdisk-hub",
        "to": "netdisk-hub",
        "filter": ["**/*", "!node_modules/**/.cache", "!**/*.log", "!data/**", "!logs/**"]
      },
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "likuan250-hash",
      "repo": "tools-hub",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "工具箱 ToolsHub",
      "artifactName": "ToolsHub-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
