# 复制本文件为 .env（一般无需手改；配置主要在 UI 内编辑并持久化到 data/config.json）
#
# biliup.exe / ffmpeg / cookies.json 路径全部 UI 可配，不硬编码 D:\。
# 以下仅为示例默认值（与 data/config.json 中的默认值一致）。

# biliup.exe 路径（默认 D:\biliupR\biliup.exe，UI 可覆盖）
BILIUP_EXE_PATH=D:\biliupR\biliup.exe

# cookies.json 路径（默认 D:\biliupR\cookies.json，UI 可覆盖）
COOKIES_PATH=D:\biliupR\cookies.json

# 本地服务端口
BILIUP_PORT=3600
