# 依赖（另一台电脑用 npm install 安装，靠 package-lock.json 锁定版本）
node_modules/

# 环境变量 / 密钥（如有）
.env
.env.*
# 代理配置（每台机器不同，不提交；复制 .proxy.example 并修改）
.proxy

# 运行日志与临时产物（按日滚动，不进 git）
logs/
.tmp/
*.log

# 运行时落盘目录不在本仓库内（默认 E:\素材\），此处仅排除可能的本地覆盖
data/

# 内置外部二进制（yt-dlp.exe ≈17MB）：由 scripts/prepare-material-bins.js 下载，
# electron-builder extraResources 打包时一并带上，不进 git（与 biliup-hub/bin 同策略）
bin/
