# 复制本文件为 .env（setup.bat 会自动生成，一般无需手改）
#
# 百度网盘鉴权（重要）：现在走「网页登录(BDUSS cookie)」，不用去百度开放平台申请应用！
#   网页点「授权百度网盘」会弹浏览器让你登录百度账号，登录后自动连上。
#   下面 BAIDU_CLIENT_ID / BAIDU_CLIENT_SECRET 仅为兼容保留，可保持默认占位、不必填写。
#   BAIDU_APP_DIR 是转存目标目录(百度网盘自动创建)，保持 /apps/netdisk_hub 默认即可。

BAIDU_CLIENT_ID=你的_client_id
BAIDU_CLIENT_SECRET=你的_client_secret
BAIDU_REDIRECT_URI=http://localhost:3000/auth/baidu/callback

# 转存目标目录,百度网盘自动创建,保持默认即可
BAIDU_APP_DIR=/apps/netdisk_hub

# ── 夸克网盘(第二阶段)─────────────────────────────────
# 夸克没有官方开放平台应用,靠本机 Playwright 登录后存 Cookie 鉴权。
# 转存目标文件夹:在你夸克网盘【根目录】下自动创建,保持默认即可。
QUARK_FOLDER=netdisk_hub
# 注意:首次 npm install 后,需再执行 `npx playwright install chromium`
# 下载浏览器内核;之后点页面「授权夸克网盘」会弹出本机浏览器让你登录。

# ── 迅雷网盘(第三阶段)─────────────────────────────────
# 迅雷没有官方开放平台应用,走「Playwright 本机登录 + 逆向接口」(与夸克同模式)。
# 点页面「授权迅雷网盘」会弹出本机浏览器打开 pan.xunlei.com,登录后自动拦截 token。
# 无需额外凭证,首次使用需执行 `npx playwright install chromium` 安装浏览器内核。
# 转存目标目录:留空=存到云盘根目录;填文件夹 id 则存到子文件夹。
# XUNLEI_DEST_FOLDER_ID=

# 本地服务端口
PORT=3000

# ── 出站代理(可选,解决「浏览器能登录但 Node 连不上网盘」)──
# 浏览器登录走系统代理/直连能成功;但 Node 服务端默认识别不到系统代理,
# 若本机网络需要代理才能访问外网(如公司内网/校园网),在此填入代理地址,
# 服务端的百度/夸克/迅雷请求才会走代理。普通家庭宽带一般留空即可(直连)。
# 示例: http://127.0.0.1:7890  或带账号  http://user:pass@host:port
# 亦兼容环境变量 HTTPS_PROXY / HTTP_PROXY(优先级低于本项)。
NETDISK_PROXY=
