{
  "name": "tools-hub",
  "version": "2.7.44",
  "description": "工具统一桌面应用：集成 kdocs-tool 与 netdisk-hub，单启动器、单安装包",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "node scripts/prepare-build.js && electron-builder --dir && node scripts/verify-build-assets.js",
    "dist": "node scripts/prepare-build.js && electron-builder --win nsis -p always && node scripts/verify-build-assets.js",
    "verify:build": "node scripts/verify-build-assets.js",
    "prepare:material-bins": "node scripts/prepare-material-bins.js",
    "prepare:biliup-bin": "node scripts/prepare-biliup-bin.js",
    "verify:status-luxe": "node scripts/verify-status-luxe-sync.js",
    "sync-status-luxe": "node scripts/sync-status-luxe.js",
    "test": "npm --prefix kdocs-tool test && npm --prefix netdisk-hub test && npm --prefix biliup-hub test && npm --prefix material-hub test && node --test renderer/test/drag-geometry.test.js test/host-utils.test.js test/verify-build-assets.test.js test/prepare-biliup-bin.test.js test/extra-resources-filter.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.js\"",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1"
  },
  "build": {
    "appId": "com.likuan.tools-hub",
    "productName": "工具箱 ToolsHub",
    "copyright": "Copyright © 2026 likuan",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "webview-preload.js",
      "lib/**/*",
      "renderer/**/*",
      "shared/**/*"
    ],
    "extraResources": [
      {
        "from": "kdocs-tool",
        "to": "kdocs-tool",
        "filter": [
          "**/*",
          "!node_modules/**/.cache",
          "!**/*.log",
          "!**/.env",
          "!**/.proxy",
          "!**/proxy-default",
          "!node_modules/**/.*-????????",
          "!node_modules/**/.*-*/**"
        ]
      },
      {
        "from": "netdisk-hub",
        "to": "netdisk-hub",
        "filter": [
          "**/*",
          "!node_modules/**/.cache",
          "!**/*.log",
          "!data/**",
          "!logs/**",
          "!**/.env",
          "!node_modules/**/.*-????????",
          "!node_modules/**/.*-*/**"
        ]
      },
      {
        "from": "netdisk-hub/node_modules/playwright-core/.local-browsers",
        "to": "netdisk-hub/node_modules/playwright-core/.local-browsers",
        "filter": ["**/*"]
      },
      {
        "from": "biliup-hub",
        "to": "biliup-hub",
        "filter": [
          "**/*",
          "!node_modules/**/.cache",
          "!**/*.log",
          "!data/**",
          "!logs/**",
          "!**/.env",
          "!.tmp/**",
          "!node_modules/**/.*-????????",
          "!node_modules/**/.*-*/**"
        ]
      },
      {
        "from": "material-hub",
        "to": "material-hub",
        "filter": [
          "**/*",
          "!node_modules/**/.cache",
          "!**/*.log",
          "!logs/**",
          "!**/.env",
          "!**/.proxy",
          "!**/proxy-default",
          "!.tmp/**",
          "!node_modules/**/.*-????????",
          "!node_modules/**/.*-*/**"
        ]
      },
      {
        "from": "resources/node",
        "to": "node"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "likuan250-hash",
      "repo": "tools-hub",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "工具箱 ToolsHub",
      "artifactName": "ToolsHub-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
